# Zaelyn Portal — plantilla. Copiar como .env.local, que NUNCA se commitea.
#
# Hoy el portal corre con datos de ejemplo (lib/demo.ts) y no necesita nada de
# esto. Las variables quedan declaradas para cuando lea el estado real.

# De dónde sale estadoDePlan(). El portal NO consulta la base: le pregunta a
# Zaelyn por HTTP, y por eso la pantalla no puede discrepar del chat.
ZAELYN_API_URL=
ZAELYN_API_TOKEN=
